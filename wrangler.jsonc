{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-bg-remover",
  "compatibility_date": "2026-04-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.js",
  "routes": [
    {
      "pattern": "image-bg-remove.shop",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "image-bg-remover-db",
      "database_id": "3f2f45d0-67ad-4432-b1c3-62d61941c4c5"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "6120d37ad2be48e8b19d809db8218bad"
    }
  ]
}
